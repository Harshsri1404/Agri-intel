# AgriIntel environment variables
# Copy this file to .env and fill in your values. Never commit .env.

# OpenWeatherMap (free tier): https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-key

# WhatsApp Business API (Meta): https://developers.facebook.com
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Use a long random string. The webhook verification refuses to work if this is empty.
WHATSAPP_VERIFY_TOKEN=change-me-to-a-long-random-string

# CORS: comma-separated list of allowed frontends. "*" is for local demos only.
ALLOWED_ORIGINS=*
